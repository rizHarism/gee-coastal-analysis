{
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/coastal-project/api/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/index.py"
        },
        {
            "source": "/coastal-project/cesium",
            "destination": "/cesium.html"
        },
        {
            "source": "/cesium",
            "destination": "/cesium.html"
        },
        {
            "source": "/coastal-project/leaflet",
            "destination": "/leaflet.html"
        },
        {
            "source": "/leaflet",
            "destination": "/leaflet.html"
        },
        {
            "source": "/coastal-project",
            "destination": "/index.html"
        }
    ]
}