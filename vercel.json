{
    "functions": {
        "api/*.py": {
            "maxDuration": 15
        }
    },
    "rewrites": [
        {
            "source": "/api/get_cvi",
            "destination": "/api/index.py"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/cesium",
            "destination": "/public/cesium.html"
        },
        {
            "source": "/leaflet",
            "destination": "/public/leaflet.html"
        },
        {
            "source": "/(.*)",
            "destination": "/public/$1"
        }
    ]
}